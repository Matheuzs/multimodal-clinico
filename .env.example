# Copie para .env (nunca versione o .env)
# Modo padrão: tudo local, sem rede. Azure só quando USE_AZURE=true.
USE_AZURE=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=
# Provedores: transcriber = local_whisper | google | azure | mock
TRANSCRIBER=local_whisper
TEXT_ANALYZER=local
